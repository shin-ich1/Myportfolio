# Environment variables, server-only credentials and generated secrets
.env
.env.*
**/.env
**/.env.*
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
# Example files may be intentionally tracked without real credentials.
!.env.example
!**/.env.example
!.dev.vars.example
!**/.dev.vars.example

# Dependencies, Cloudflare/Firebase caches, and generated publish candidates
node_modules/
**/node_modules/
.wrangler/
**/.wrangler/
.firebase/
**/.firebase/
.hosting-dist/
.hosting-preview/

# Keys, certificates and service-account data
*.pem
*.key
*.p12
*.pfx
service-account*.json
**/service-account*.json
*credentials*.json
**/*credentials*.json
gha-creds-*.json
**/gha-creds-*.json

# OS metadata
.DS_Store
Thumbs.db

# Generated staging output, test artifacts and local diagnostics
.lan-staging/
.lan-staging.tmp-*/
firebase-debug.log
**/firebase-debug.log
firebase-debug.*.log
**/firebase-debug.*.log
npm-debug.log*
**/npm-debug.log*
