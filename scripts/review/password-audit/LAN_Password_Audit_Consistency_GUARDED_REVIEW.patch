diff --git a/tests/security-password-audit-ui.test.mjs b/tests/security-password-audit-ui.test.mjs
new file mode 100644
index 0000000..a3dfd42
--- /dev/null
+++ b/tests/security-password-audit-ui.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = readFileSync(new URL('../admin/js/settings-security.js', import.meta.url), 'utf8');
+const match = source.match(/\$\('securityChangePasswordForm'\)\?\.addEventListener\('submit', async event => \{([\s\S]*?)\n\}\);/);
+assert.ok(match, 'Canonical password handler must remain present');
+const runHandler = new Function('event', '$', 'stepUp', 'changeAdministratorPassword', 'refresh',
+  `return (async () => {${match[1]}})();`);
+
+function fixture({auditState='recorded',refreshFails=false,outcomeUnknown=false}={}){
+  const event={currentTarget:{reset(){event.resets++;}},resets:0,preventDefault(){}};
+  const inputs={
+    securityCurrentPassword:{value:'fake-current-password'},
+    securityNewPassword:{value:'fake-new-password-123!'},
+    securityConfirmPassword:{value:'fake-new-password-123!'},
+    securityPasswordStatus:{textContent:''}
+  };
+  return {event,inputs,run:()=>runHandler(event,key=>inputs[key],
+    async()=>{event.currentTarget=null;},
+    async()=>{if(outcomeUnknown)throw Error('Password update outcome is unknown. Verify access before retrying.');return {ok:true,auditState};},
+    async()=>{if(refreshFails)throw Error('test-only refresh failed');})};
+}
+
+test('admin UI retains form handle across asynchronous TOTP step-up and confirms recorded audit',async()=>{
+  const f=fixture();await f.run();
+  assert.equal(f.event.resets,1);
+  assert.match(f.inputs.securityPasswordStatus.textContent,/Password changed.*recorded server-side/);
+});
+
+test('admin UI reports audit pending after confirmed password change without claiming event recorded',async()=>{
+  const f=fixture({auditState:'pending',refreshFails:true});await f.run();
+  assert.equal(f.event.resets,1);
+  assert.match(f.inputs.securityPasswordStatus.textContent,/Password changed.*confirmation is pending/);
+  assert.match(f.inputs.securityPasswordStatus.textContent,/could not be refreshed/);
+  assert.doesNotMatch(f.inputs.securityPasswordStatus.textContent,/recorded server-side/);
+});
+
+test('admin UI does not reset the form or claim success when provider outcome is unknown',async()=>{
+  const f=fixture({outcomeUnknown:true});await f.run();
+  assert.equal(f.event.resets,0);
+  assert.match(f.inputs.securityPasswordStatus.textContent,/outcome is unknown/);
+  assert.doesNotMatch(f.inputs.securityPasswordStatus.textContent,/Password changed/);
+});
